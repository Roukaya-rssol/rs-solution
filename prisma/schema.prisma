generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Company {
  id               String   @id @default(cuid())
  name             String
  slug             String   @unique
  status           String   @default("ACTIVE")
  defaultLanguage  String   @default("FR")
  timezone         String   @default("Africa/Casablanca")
  logoUrl          String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  users            UserCompany[]
  sites            Site[]
  departments      Department[]
  zones            Zone[]
  events           Event[]
  actions          ActionItem[]
  notifications    Notification[]
  auditLogs        AuditLog[]
}

model User {
  id               String   @id @default(cuid())
  firstName        String
  lastName         String
  email            String   @unique
  passwordHash     String
  locale           String   @default("FR")
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  companies        UserCompany[]
  comments         EventComment[]
  actionComments   ActionComment[]

  uploadedEventAttachments  EventAttachment[]  @relation("EventAttachmentUploadedBy")
  uploadedActionAttachments ActionAttachment[] @relation("ActionAttachmentUploadedBy")

  reportedEvents   Event[] @relation("EventReporter")
  assignedEvents   Event[] @relation("EventAssignee")

  createdActions      ActionItem[] @relation("ActionCreatedBy")
  responsibleActions  ActionItem[] @relation("ActionResponsible")
  validatedActions    ActionItem[] @relation("ActionValidatedBy")

  investigations            EventInvestigation[] @relation("InvestigationCreatedBy")
  validatedInvestigations   EventInvestigation[] @relation("InvestigationValidatedBy")

  notifications    Notification[]
  auditLogs        AuditLog[]
}

model Role {
  id               String   @id @default(cuid())
  code             String   @unique
  name             String
  description      String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  userCompanyRoles UserCompanyRole[]
}

model Permission {
  id               String   @id @default(cuid())
  code             String   @unique
  name             String
  description      String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model UserCompany {
  id               String   @id @default(cuid())
  userId           String
  companyId        String
  jobTitle         String?
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  company          Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  roles            UserCompanyRole[]

  @@unique([userId, companyId])
  @@index([companyId])
  @@index([userId])
}

model UserCompanyRole {
  id               String      @id @default(cuid())
  userCompanyId    String
  roleId           String
  createdAt        DateTime    @default(now())

  userCompany      UserCompany @relation(fields: [userCompanyId], references: [id], onDelete: Cascade)
  role             Role        @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userCompanyId, roleId])
  @@index([roleId])
}

model Site {
  id               String   @id @default(cuid())
  companyId        String
  name             String
  code             String?
  location         String?
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  company          Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  departments      Department[]
  zones            Zone[]
  events           Event[]

  @@unique([companyId, name])
  @@index([companyId])
}

model Department {
  id               String   @id @default(cuid())
  companyId        String
  siteId           String?
  name             String
  code             String?
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  company          Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  site             Site?    @relation(fields: [siteId], references: [id], onDelete: SetNull)
  zones            Zone[]
  events           Event[]

  @@unique([companyId, name])
  @@index([companyId])
  @@index([siteId])
}

model Zone {
  id               String   @id @default(cuid())
  companyId        String
  siteId           String?
  departmentId     String?
  name             String
  code             String?
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  company          Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  site             Site?       @relation(fields: [siteId], references: [id], onDelete: SetNull)
  department       Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  events           Event[]

  @@unique([companyId, name])
  @@index([companyId])
  @@index([siteId])
  @@index([departmentId])
}

model Event {
  id                    String   @id @default(cuid())
  companyId             String
  eventNumber           String
  module                String
  eventType             String
  title                 String
  description           String

  eventDate             DateTime
  reportedAt            DateTime @default(now())

  siteId                String?
  departmentId          String?
  zoneId                String?

  workRelated           Boolean  @default(true)
  affectedPerson        Boolean  @default(false)
  affectedPersonType    String?

  riskCategory          String?
  severity              String?
  priority              String?
  potentialSeverity     String?

  immediateActions      String?
  initialAnalysis       String?
  rcaSummary            String?

  cardinalRuleBreached  Boolean  @default(false)
  cardinalRule          String?

  status                String   @default("REPORTED")

  reporterId            String
  assigneeId            String?

  closedAt              DateTime?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  company               Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  site                  Site?       @relation(fields: [siteId], references: [id], onDelete: SetNull)
  department            Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  zone                  Zone?       @relation(fields: [zoneId], references: [id], onDelete: SetNull)

  reporter              User        @relation("EventReporter", fields: [reporterId], references: [id], onDelete: Restrict)
  assignee              User?       @relation("EventAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  investigation         EventInvestigation?
  comments              EventComment[]
  attachments           EventAttachment[]
  actions               ActionItem[]

  @@unique([companyId, eventNumber])
  @@index([companyId])
  @@index([module])
  @@index([eventType])
  @@index([status])
  @@index([severity])
  @@index([priority])
  @@index([eventDate])
  @@index([siteId])
  @@index([departmentId])
  @@index([zoneId])
  @@index([reporterId])
  @@index([assigneeId])
}

model EventInvestigation {
  id                    String   @id @default(cuid())
  eventId               String   @unique
  investigatorId        String
  summary               String?
  rootCause             String?
  method                String?
  correctiveSummary     String?
  preventiveSummary     String?
  validatedById         String?
  validatedAt           DateTime?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  event                 Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  investigator          User     @relation("InvestigationCreatedBy", fields: [investigatorId], references: [id], onDelete: Restrict)
  validatedBy           User?    @relation("InvestigationValidatedBy", fields: [validatedById], references: [id], onDelete: SetNull)

  @@index([investigatorId])
  @@index([validatedById])
}

model EventComment {
  id                    String   @id @default(cuid())
  eventId               String
  authorId              String
  content               String
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  event                 Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  author                User     @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([eventId])
  @@index([authorId])
}

model EventAttachment {
  id                    String   @id @default(cuid())
  eventId               String
  fileName              String
  fileUrl               String
  fileType              String   @default("DOCUMENT")
  mimeType              String?
  fileSize              Int?
  uploadedById          String
  createdAt             DateTime @default(now())

  event                 Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  uploadedBy            User     @relation("EventAttachmentUploadedBy", fields: [uploadedById], references: [id], onDelete: Restrict)

  @@index([eventId])
  @@index([uploadedById])
}

model ActionItem {
  id                    String   @id @default(cuid())
  companyId             String
  eventId               String?
  title                 String
  description           String?
  actionType            String
  status                String   @default("OPEN")

  responsibleId         String
  dueDate               DateTime?
  completionComment     String?
  completedAt           DateTime?

  createdById           String
  validatedById         String?
  validatedAt           DateTime?

  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  company               Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  event                 Event?   @relation(fields: [eventId], references: [id], onDelete: SetNull)
  responsible           User     @relation("ActionResponsible", fields: [responsibleId], references: [id], onDelete: Restrict)
  createdBy             User     @relation("ActionCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  validatedBy           User?    @relation("ActionValidatedBy", fields: [validatedById], references: [id], onDelete: SetNull)

  comments              ActionComment[]
  attachments           ActionAttachment[]

  @@index([companyId])
  @@index([eventId])
  @@index([responsibleId])
  @@index([createdById])
  @@index([validatedById])
  @@index([status])
  @@index([dueDate])
}

model ActionComment {
  id                    String   @id @default(cuid())
  actionId              String
  authorId              String
  content               String
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  action                ActionItem @relation(fields: [actionId], references: [id], onDelete: Cascade)
  author                User       @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([actionId])
  @@index([authorId])
}

model ActionAttachment {
  id                    String   @id @default(cuid())
  actionId              String
  fileName              String
  fileUrl               String
  fileType              String   @default("DOCUMENT")
  mimeType              String?
  fileSize              Int?
  uploadedById          String
  createdAt             DateTime @default(now())

  action                ActionItem @relation(fields: [actionId], references: [id], onDelete: Cascade)
  uploadedBy            User       @relation("ActionAttachmentUploadedBy", fields: [uploadedById], references: [id], onDelete: Restrict)

  @@index([actionId])
  @@index([uploadedById])
}

model Notification {
  id                    String   @id @default(cuid())
  companyId             String
  userId                String
  type                  String
  title                 String
  message               String
  status                String   @default("UNREAD")
  link                  String?
  createdAt             DateTime @default(now())
  readAt                DateTime?

  company               Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

model AuditLog {
  id                    String   @id @default(cuid())
  companyId             String?
  userId                String?
  entityType            String
  entityId              String
  action                String
  oldValues             String?
  newValues             String?
  createdAt             DateTime @default(now())

  company               Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  user                  User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([companyId])
  @@index([userId])
  @@index([entityType, entityId])
  @@index([createdAt])
}